{
  "name": "devtools-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n util,pdf,image,media,shell -c magenta,yellow,green,orange,cyan \"npm:dev:utility\" \"npm:dev:pdf\" \"npm:dev:image\" \"npm:dev:media\" \"npm:dev:shell\"",
    "dev:utility": "npm run dev --workspace @devtools/utility-tools",
    "dev:pdf": "npm run dev --workspace @devtools/pdf-tools",
    "dev:image": "npm run dev --workspace @devtools/image-tools",
    "dev:media": "npm run dev --workspace @devtools/media-tools",
    "dev:shell": "npm run dev --workspace @devtools/shell",
    "build": "npm run build:remotes && npm run build:shell && npm run assemble",
    "build:remotes": "npm run build:utility && npm run build:pdf && npm run build:image && npm run build:media",
    "build:utility": "npm run build --workspace @devtools/utility-tools",
    "build:pdf": "npm run build --workspace @devtools/pdf-tools",
    "build:image": "npm run build --workspace @devtools/image-tools",
    "build:media": "npm run build --workspace @devtools/media-tools",
    "build:shell": "npm run build --workspace @devtools/shell",
    "//assemble": "NOT named 'postbuild' — npm would then run it twice, once explicitly from `build` and once via its implicit post-<script> lifecycle hook.",
    "assemble": "node scripts/postbuild.mjs",
    "test": "node scripts/postbuild.test.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vite": "7.3.6"
  }
}
