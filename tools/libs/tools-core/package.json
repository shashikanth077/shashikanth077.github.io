{
  "name": "@devtools/tools-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "//sideEffects": "Every module here is pure functions — no top-level work, no globals. Marking it lets Rollup drop unreferenced re-exports from the barrel, which otherwise pulls bwip-js (1.2MB) into every tool that imports anything from this package.",
  "sideEffects": false,
  "dependencies": {
