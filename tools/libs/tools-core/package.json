    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "dompurify": "^3.4.12",
    "html2canvas": "^1.4.1",
    "js-beautify": "^2.0.3",
    "jspdf": "^4.2.1",
    "mammoth": "^1.12.0",
    "marked": "^18.0.7",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/js-beautify": "^1.14.3",
    "@types/qrcode": "^1.5.5"
  }
